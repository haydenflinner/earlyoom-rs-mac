<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for earlyoom on macOS.

  Runs in the user session, which is enough to kill the user's own
  processes (browsers, build jobs, test binaries). No root needed.

  Install:
    cargo build --release
    install -m 755 target/release/earlyoom ~/.local/bin/earlyoom
    cp com.earlyoom.earlyoom.plist ~/Library/LaunchAgents/
    launchctl bootstrap "gui/$UID" ~/Library/LaunchAgents/com.earlyoom.earlyoom.plist

  Logs go to ~/Library/Logs/earlyoom.{out,err}.log - not /tmp, which macOS
  clears at boot, taking the post-mortem of a freeze with it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.earlyoom.earlyoom</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/wow/.local/bin/earlyoom</string>
        <string>--prefer</string><string>rustc|cargo|clang|clang\+\+|\bld\b|lld|ld64</string>
        <!-- Memory report every 60 s; every 1 s under memory pressure. -->
        <string>-r</string><string>60</string>
        <!-- Tune to taste, e.g.: -->
        <!-- <string>--swap-grow</string><string>1024,2048</string> -->
        <!-- <string>--avoid</string><string>WindowServer|loginwindow</string> -->
        <!-- <string>-n</string> -->
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/wow/Library/Logs/earlyoom.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wow/Library/Logs/earlyoom.err.log</string>
    <!-- Not Background: that throttles CPU and I/O exactly when earlyoom
         has to page itself back in and act. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
